# ─── Site URL ─────────────────────────────────────────────────────────────────
# Used in metadataBase for OG tags, canonical URLs, and sitemap.
# Set to your production domain (with https://, no trailing slash).
# Falls back to https://joechawley.com if not set. Also enables the 308 redirects
# from research.joechawley.com and www.joechawley.com (next.config.mjs).
NEXT_PUBLIC_SITE_URL=https://joechawley.com

# ─── Analytics ────────────────────────────────────────────────────────────────
# Analytics is not in use. Keep NEXT_PUBLIC_PLAUSIBLE_DOMAIN unset unless the
# researcher decides otherwise. If set, the dormant Plausible script loads for
# that domain (no https://, no path).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
